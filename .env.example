# Set these in your hosting platform's environment settings. Node does not load this example automatically.
PORT=3000
NODE_ENV=production
APP_ORIGIN=https://iemfaraz.github.io
# Required for the GitHub Pages team client; access tokens stay in memory only.
CROSS_SITE_COOKIES=true
DATABASE_PATH=/data/enginex.sqlite
# Optional: seed the first administrator on startup. No default admin password exists.
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
